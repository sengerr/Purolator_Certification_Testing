<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <soap:Header>
        <RequestContext xmlns="http://purolator.com/pws/datatypes/v1">
            <Version>1.6</Version>
            <Language>en</Language>
            <GroupID/>
            <RequestReference>RequestReference</RequestReference>
            <UserToken></UserToken>
        </RequestContext>
    </soap:Header>
    <soap:Body>
        <GetDocumentsRequest xmlns="http://purolator.com/pws/datatypes/v1">
        <OutputType>PNG</OutputType>
        <Synchronous>false</Synchronous>
            <DocumentCriterium>
                <DocumentCriteria>
                    <PIN>
                        <Value>{{PIN}}</Value>
                    </PIN>
                    <DocumentTypes>
                        <DocumentType>QRCode</DocumentType>
                    </DocumentTypes>
                </DocumentCriteria>
            </DocumentCriterium>
        </GetDocumentsRequest>
    </soap:Body>
</soap:Envelope>
