<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns="http://purolator.com/pws/datatypes/v1">
   <soapenv:Header>
      <RequestContext>
         <Version>1.0</Version>
         <Language>en</Language>
         <GroupID>1</GroupID>
         <RequestReference>{{RequestReference}}</RequestReference>
      </RequestContext>
   </soapenv:Header>
   <soapenv:Body>
      <SchedulePickUpRequest>
         <BillingAccountNumber>{{AccountNumber}}</BillingAccountNumber>
         <PickupInstruction>
            <Date>{{Pickup_Date}}</Date>
            <AnyTimeAfter>1300</AnyTimeAfter>
            <UntilTime>1700</UntilTime>
            <TotalWeight>
               <Value>7</Value>
               <WeightUnit>lb</WeightUnit>
            </TotalWeight>
            <TotalPieces>1</TotalPieces>
            <PickUpLocation>FrontDesk</PickUpLocation>
            <AdditionalInstructions>Sample pickup</AdditionalInstructions>
            <TrailerAccessible>false</TrailerAccessible>
            <LoadingDockAvailable>false</LoadingDockAvailable>
            <ShipmentOnSkids>false</ShipmentOnSkids>
            <NumberOfSkids>0</NumberOfSkids>
         </PickupInstruction>
         <Address>
            <Name>Shipping</Name>
            <Company>Sample Co</Company>
            <StreetNumber>5995</StreetNumber>
            <StreetName>Avebury</StreetName>
            <StreetType>Road</StreetType>
            <City>Mississauga</City>
            <Province>ON</Province>
            <Country>CA</Country>
            <PostalCode>L5R3T8</PostalCode>
            <PhoneNumber>
               <CountryCode>1</CountryCode>
               <AreaCode>416</AreaCode>
               <Phone>1234567</Phone>
            </PhoneNumber>
         </Address>
         <ShipmentSummary>
            <ShipmentSummaryDetails>
               <ShipmentSummaryDetail>
                  <DestinationCode>DOM</DestinationCode>
                  <ModeOfTransport>Ground</ModeOfTransport>
                  <TotalPieces>1</TotalPieces>
                  <TotalWeight>
                     <Value>7</Value>
                     <WeightUnit>lb</WeightUnit>
                  </TotalWeight>
               </ShipmentSummaryDetail>
            </ShipmentSummaryDetails>
         </ShipmentSummary>
         <NotificationEmails>
            <NotificationEmail>shipping@example.com</NotificationEmail>
         </NotificationEmails>
      </SchedulePickUpRequest>
   </soapenv:Body>
</soapenv:Envelope>
