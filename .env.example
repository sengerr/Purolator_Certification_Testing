# Copy to .env.development (and .env.production for Production runs). Never commit these files.
# Names match the Postman environment variables in postman/HOW-TO-LOAD.md.

# SOAP (E-Ship Web Services)
SOAP_Key=
SOAP_Password=

# REST
REST_ClientId=
REST_Secret=
REST_XApiKey=

# Accounts
AccountNumber=
Different_AccountNumber=
Freight_account=

# Optional: days ahead for the ship date (default 1)
shipDaysAhead=1
